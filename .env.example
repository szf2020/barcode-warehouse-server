# Database type: sqlite or postgresql
DB_TYPE=sqlite

# SQLite (used when DB_TYPE=sqlite)
SQLITE_PATH=./warehouse.db

# PostgreSQL (used when DB_TYPE=postgresql)
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=warehouse

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_QUERY=warehouse/query
MQTT_TOPIC_CREATE=warehouse/create
MQTT_TOPIC_RESPONSE=warehouse/response
